{
  "slug": "shore",
  "name": { "en": "Shore", "ko": "바닷가" },
  "scenes": [
    { "when": { "state": "stale" }, "show": "fog.webp" },
    { "when": { "state": ["idle", "done"] }, "show": "night.webp" },
    { "when": { "bound": "over" }, "show": "over.webp",
      "effects": [
        { "type": "drift", "image": "fish.webp", "amount": "over", "size": 0.08 },
        { "type": "float", "image": "dot.webp", "amount": 0.5, "size": 0.03 }
      ] },
    { "when": { "bound": "under" }, "show": "dry.webp" },
    { "when": { "level": "full" }, "show": "full.webm", "poster": "full.webp",
      "effects": [{ "type": "float", "image": "dot.webp", "amount": "fill", "size": 0.03 }] },
    { "when": { "level": "high" }, "show": "high.webp",
      "effects": [{ "type": "drift", "image": "dot.webp", "amount": "momentum", "size": 0.03 }] },
    { "when": { "level": "mid" }, "show": "mid.webp" },
    { "when": { "level": "low" }, "show": "low.webp" },
    { "when": { "level": "empty" }, "show": "empty.webp" },
    { "show": "mid.webp" }
  ],
  "events": [{ "on": "score", "play": "burst.webm" }],
  "fade": 1
}
